{
  "name": "eveglyph-editor-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Packaging recipe for the EveGlyph Editor Windows desktop app (Electron). Kept separate so the main project's `npm ci` never downloads Electron.",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dist": "node build.mjs",
    "stage": "node build.mjs --stage-only",
    "smoke": "node build.mjs --smoke-only",
    "installer-test": "node build.mjs --installer-test"
  },
  "dependencies": {
    "connect": "3.7.0",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
